@model duktur.Models.Ticket
@{
    ViewData["Title"] = "Müraciəti sil";
}

<div class="container mt-4">
    <h2>Müraciəti silmək</h2>
    <div class="alert alert-warning">
        Bu müraciəti silmək istədiyinizə əminsiniz?
    </div>

    <div class="card p-4 shadow-sm mb-3">
        <h4>@Model.Title</h4>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Bəli, sil</button>
        <a asp-action="Index" class="btn btn-secondary">Xeyr</a>
    </form>
</div>